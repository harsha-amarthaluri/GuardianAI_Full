<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#0F172A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register to start using proactive Guardian AI protection"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="28dp" />

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name *"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editRegFullName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="Jane Doe"
            android:textColorHint="#64748B"
            android:inputType="textPersonName"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address *"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editRegEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="jane.doe@example.com"
            android:textColorHint="#64748B"
            android:inputType="textEmailAddress"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- Phone Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editRegPhone"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="+1234567890"
            android:textColorHint="#64748B"
            android:inputType="phone"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password (min 8 chars) *"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editRegPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="••••••••"
            android:textColorHint="#64748B"
            android:inputType="textPassword"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="14dp" />

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Password *"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/editRegConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="••••••••"
            android:textColorHint="#64748B"
            android:inputType="textPassword"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:background="#1E293B"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textRegError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <ProgressBar
            android:id="@+id/progressBarRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="#38BDF8"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/buttonRegister"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Register Account"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#0EA5E9"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/textLoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? Sign in"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:layout_gravity="center" />

    </LinearLayout>

</ScrollView>
