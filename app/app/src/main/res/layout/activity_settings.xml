<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚙️ Application &amp; Safety Settings"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Configure real-time detection, privacy defaults, and account security."
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Emergency Triggers Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚨 Automatic Detection Triggers"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchShakeSos"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Shake Device for SOS"
                android:textColor="#334155"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchFallDetection"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Fall &amp; Impact Detection"
                android:textColor="#334155"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchVoiceDistress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Voice Distress &amp; Vocal Strain Detection"
                android:textColor="#334155"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Privacy Controls Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Privacy &amp; Evidence Controls"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchLocationSharing"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Live GPS Telemetry Sharing"
                android:textColor="#334155"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/switchEvidenceRecording"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:checked="true"
                android:text="Automatic Emergency Audio Recording"
                android:textColor="#334155"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#0284C7"
            android:text="Save Settings"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
