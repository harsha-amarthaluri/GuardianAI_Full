<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A">

    <!-- Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#020617"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 Guardian AI Support Assistant"
            android:textColor="#38BDF8"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Chat Messages Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/containerChatMessages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Chat Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:padding="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/editChatMessage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="Ask AI safety assistant..."
            android:textColorHint="#64748B"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:background="#0F172A"
            android:textColor="#FFFFFF"
            android:layout_marginRight="8dp" />

        <Button
            android:id="@+id/btnSendChatMessage"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Send"
            android:backgroundTint="#0EA5E9"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</LinearLayout>
