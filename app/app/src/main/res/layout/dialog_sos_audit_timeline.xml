<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_white">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 Emergency Incident Audit Timeline"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cryptographically verifiable timestamped event log sequence"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sos_events"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btn_close_dialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Close Timeline"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#0284C7"
        android:layout_marginTop="16dp" />

</LinearLayout>
