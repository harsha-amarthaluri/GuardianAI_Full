<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textGuardianName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardian Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#0F172A" />

        <TextView
            android:id="@+id/textGuardianDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone | Email"
            android:textSize="13sp"
            android:textColor="#64748B" />
    </LinearLayout>

    <Button
        android:id="@+id/btnEditGuardian"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Edit"
        android:textSize="12sp"
        android:backgroundTint="#0EA5E9"
        android:textColor="#FFFFFF"
        android:layout_marginEnd="4dp" />

    <Button
        android:id="@+id/btnDeleteGuardian"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Del"
        android:textSize="12sp"
        android:backgroundTint="#EF4444"
        android:textColor="#FFFFFF" />

</LinearLayout>
