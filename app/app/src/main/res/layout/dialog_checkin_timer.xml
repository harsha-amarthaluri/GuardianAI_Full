<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_card_white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⏱️ Safety Check-in Timer"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Schedule a safety timer. If you don't check in before it expires, your guardians will be notified automatically."
        android:textColor="#64748B"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Duration (Minutes)"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editCheckinDuration"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#F1F5F9"
        android:hint="e.g. 15, 30, 60"
        android:inputType="number"
        android:padding="12dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Destination / Activity Note"
        android:textColor="#334155"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editCheckinNote"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="#F1F5F9"
        android:hint="Walking home from campus"
        android:padding="12dp"
        android:textColor="#0F172A"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCheckin"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="#64748B" />

        <Button
            android:id="@+id/btnStartCheckinTimer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:backgroundTint="#0284C7"
            android:text="Start Timer"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
